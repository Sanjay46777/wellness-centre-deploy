# Backend
PORT=3001
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=wellness_centre

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=1h

# Frontend
FRONTEND_URL=http://localhost:50000

# Email (optional; omit to log reset links in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=Wellness Centre <wellness@smail.iitm.ac.in>

# Frontend mock API (use true for local preview without backend)
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:3001/api
