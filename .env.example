# Backend
PORT=3001
NODE_ENV=development

# Database (MySQL)
# Local (Docker): DB_HOST=localhost, DB_SSL=false
# Aiven free MySQL: set DB_SSL=true and DB_HOST to your Aiven host
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=wellness_centre
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=1h

# Frontend
FRONTEND_URL=http://localhost:50000

# Email (optional; omit to log reset links in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=Wellness Centre <wellness@smail.iitm.ac.in>

# Frontend (built by Vite; VITE_* vars are inlined at build time)
# In production this must be the public URL of your backend, e.g. https://your-app.onrender.com/api
VITE_API_BASE_URL=http://localhost:3001/api
