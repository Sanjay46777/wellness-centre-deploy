# Backend
PORT=3001
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=wellness
DB_PASSWORD=wellness
DB_NAME=wellness_centre
DB_SSL=false

# Docker MySQL values (used by docker-compose)
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=wellness_centre
MYSQL_USER=wellness
MYSQL_PASSWORD=wellness

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=1h
AUTH_RATE_LIMIT_MAX=5

# Frontend
FRONTEND_URL=http://localhost:50000

# Email (optional; omit to log reset links in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=Wellness Centre <wellness@smail.iitm.ac.in>

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api
